{
  "_comment": "Output contract: schema of state/runs/<timestamp>-<slug>.json. The sub-agent MUST write a file matching this shape. The main agent reads it to relay results.",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResearchResult",
  "type": "object",
  "required": ["id", "topic", "question", "depth_tier", "created_at", "findings", "sources", "confidence", "flags"],
  "properties": {
    "id": { "type": "string", "description": "ISO-8601 timestamp + slug, e.g. 2026-08-27T14-55-00Z-eu-ai-act" },
    "topic": { "type": "string" },
    "question": { "type": "string", "description": "The original research question as the user phrased it." },
    "depth_tier": { "enum": ["quick", "standard", "deep"] },
    "created_at": { "type": "string", "format": "date-time" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "confidence", "supporting_sources"],
        "properties": {
          "claim": { "type": "string" },
          "confidence": { "enum": ["H", "M", "L"] },
          "reasoning": { "type": "string" },
          "supporting_sources": {
            "type": "array",
            "items": { "type": "integer", "description": "Index into sources[]" }
          },
          "conflicting_sources": {
            "type": "array",
            "items": { "type": "integer" }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "title", "tier", "accessed_at"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "publisher": { "type": "string" },
          "tier": { "enum": [1, 2, 3] },
          "accessed_at": { "type": "string", "format": "date-time" },
          "published_at": {
            "type": ["string", "null"],
            "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$",
            "description": "YYYY-MM-DD if known, YYYY-MM if publisher only gives month, null if unknown."
          },
          "coi_flag": {
            "type": "object",
            "properties": {
              "present": { "type": "boolean" },
              "detail": { "type": "string" }
            }
          }
        }
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["H", "M", "L"],
      "description": "Overall confidence in the result. H = ≥2 independent tier-1/2 sources agree. M = mixed. L = gaps, conflicts, or tier-3 reliance."
    },
    "flags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Open issues: conflicts, gaps, recency concerns, COI concerns, single-source claims."
    },
    "summary": {
      "type": "string",
      "description": "2-4 sentence plain-language summary suitable for chat relay."
    }
  }
}